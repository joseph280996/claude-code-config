      "mcp__lean-ctx__ctx_execute",
      "mcp__lean-ctx__ctx_feedback",
      "mcp__lean-ctx__ctx_control",
      "mcp__lean-ctx__ctx_compile",
      "mcp__lean-ctx__ctx_discover_tools",
      "mcp__lean-ctx__ctx_radar",
      "mcp__lean-ctx__ctx_compress_memory",
      "mcp__lean-ctx__ctx_load_tools",
      "mcp__lean-ctx__ctx"
    ],
    "deny": [
      "Grep",
      "Glob"
    ],
    "defaultMode": "auto"
  },
  "model": "zai-org/GLM-5.3[1m]",
  "modelPicker": {
    "options": [
      {
        "model": "us.anthropic.claude-haiku-5-5",
        "label": "Claude Haiku 5.5",
        "description": "Bedrock, 1M context, US (data leaves Private Cloud)"
      },
      {
        "model": "us.anthropic.claude-sonnet-5-5",
        "label": "Claude Sonnet 5.5",
        "description": "Bedrock, 1M context, US (data leaves Private Cloud)"
      },
      {
        "model": "us.anthropic.claude-opus-5-5",
        "label": "Claude Opus 5.5",
        "description": "Bedrock, 1M context, US (data leaves Private Cloud)"
      },
      {
        "model": "openai.gpt-5.5",
        "label": "OpenAI GPT-5.5",
        "description": "Bedrock, 1.05M context, US (data leaves Private Cloud)"
      },
      {
        "model": "zai-org/GLM-5.3-Flash[1m]",
        "label": "GLM-5.3-Flash",
        "description": "On-prem, 18B params, 1M context, US & UK"
      },
      {
        "model": "zai-org/GLM-5.3[1m]",
        "label": "GLM-5.3",
        "description": "On-prem, 40B params, 1M context, US & UK"
      },
      {
        "model": "google/gemma-4-31B-it",
        "label": "google/gemma-4-31B-it",
        "description": "On-prem, 31B params, 256k context, US & UK"
      },
      {
        "model": "google/gemma-4-26B-A4B-it",
        "label": "google/gemma-4-26B-A4B-it",
        "description": "On-prem, 3.8B params, 256k context, US"
      }
    ],
    "replaceBuiltInOptions": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "lean-ctx hook observe"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/lean-ctx hook read-dedup"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "lean-ctx hook observe"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "agent",
            "prompt": "A git commit is about to run. Review the STAGED changes before allowing it. Steps: (1) Run `git diff --cached` to see exactly what will be committed. If the diff is empty, verify with `git status` — if nothing is staged, approve (nothing to review). (2) Review the staged diff for CRITICAL and HIGH issues per the project's code-review standards: hardcoded secrets/credentials/API keys, SQL injection, XSS, path traversal, auth bypasses, data-loss risks, unhandled errors that could crash, and leftover debug/console statements. (3) DECISION: If you find any CRITICAL issue (security vulnerability or data-loss risk), BLOCK the commit and explain each finding with file:line and a concrete fix. If you find only HIGH/MEDIUM/LOW issues, APPROVE but list them as warnings so the developer can decide. Keep the review scoped strictly to the staged diff — do not review unrelated existing code. Hook input: $ARGUMENTS",
            "if": "Bash(git commit*)",
            "timeout": 300,
            "model": "us.anthropic.claude-opus-5",
            "statusMessage": "Reviewing staged changes before commit..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "agent",
            "prompt": "A git push is about to run. Review the commits that will be pushed before allowing it. Steps: (1) Determine what will be pushed: run `git rev-parse --abbrev-ref --symbolic-full-name @{u}` to find the upstream; if it succeeds, diff with `git diff @{u}..HEAD`; if there is no upstream (new branch), diff against the default branch with `git diff origin/HEAD..HEAD` (fall back to `git diff origin/main..HEAD` or `git diff origin/master..HEAD`). If the diff is empty, approve (nothing new to review). (2) Review the outgoing diff for CRITICAL and HIGH issues per the project's code-review standards: hardcoded secrets/credentials/API keys, SQL injection, XSS, path traversal, auth bypasses, data-loss risks, unhandled errors, and leftover debug statements. Prefer the review-pr skill's rigor if available. (3) DECISION: If you find any CRITICAL issue, BLOCK the push and explain each finding with file:line and a concrete fix. If you find only HIGH/MEDIUM/LOW issues, APPROVE but list them as warnings. Scope the review to the outgoing commits only. Hook input: $ARGUMENTS",
            "if": "Bash(git push*)",
            "timeout": 300,
            "model": "us.anthropic.claude-opus-5",
            "statusMessage": "Reviewing outgoing commits before push..."
          }
        ]
      },
      {
        "matcher": "Bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/lean-ctx hook rewrite"
          }
        ]
      },
      {
        "matcher": "Read|read|ReadFile|read_file|View|view|Grep|grep|Search|search|ListFiles|list_files|ListDirectory|list_directory|Glob|glob",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/lean-ctx hook redirect"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "lean-ctx hook observe"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "lean-ctx hook observe"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'out=$($HOME/.config/opencode/scripts/check-skill-links.sh 2>&1) || { echo \"WARNING: broken skill symlinks detected:\"; echo \"$out\"; }'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/tpham4/config/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "lean-ctx hook observe"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "lean-ctx hook observe"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
